PREFIX ex: <http://example.org/>

SELECT * WHERE {
  { SERVICE ex:identifierRegistry { ?s ex:job ?job } }
  UNION { SERVICE ex:jobRegistry { ?s ex:job ?job } }
  UNION { SERVICE ex:socialNetwork { ?s ex:job ?job } }

  { SERVICE ex:identifierRegistry { ?s ex:age ?age } }
  UNION { SERVICE ex:jobRegistry { ?s ex:age ?age } }
  UNION { SERVICE ex:socialNetwork { ?s ex:age ?age } }

  { SERVICE ex:identifierRegistry { ?s ex:email ?email } }
  UNION { SERVICE ex:jobRegistry { ?s ex:email ?email } }
  UNION { SERVICE ex:socialNetwork { ?s ex:email ?email } }

  { SERVICE ex:identifierRegistry { ?s ex:id ?id } }
  UNION { SERVICE ex:jobRegistry { ?s ex:id ?id } }
  UNION { SERVICE ex:socialNetwork { ?s ex:id ?id } }
}
